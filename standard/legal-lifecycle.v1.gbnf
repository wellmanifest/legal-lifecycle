# Canonical legal lifecycle request v1. The accepted language is the
# intersection of this grammar and legal-lifecycle.schema.json. It cannot emit
# legal prose, personal names, addresses, emails, payment data, credentials,
# court filings or an inline authority decision.
root ::= request
request ::= "{\"$schema\":\"https://wellmanifest.dev/schemas/legal-lifecycle/v1\",\"schema\":\"wellmanifest.legal-lifecycle-request/v1\",\"requestId\":" identifier ",\"operation\":" operation ",\"accountRef\":" account-ref ",\"productRef\":" product-ref ",\"packRef\":" pack-ref ",\"jurisdictionRef\":" jurisdiction-ref ",\"intentRef\":" intent-ref ",\"grantRef\":" grant-ref ",\"planHash\":" sha256 "}"
operation ::= "\"inspect\"" | "\"bind_jurisdiction\"" | "\"accept_policy\"" | "\"grant_license\"" | "\"withdraw\"" | "\"check_availability\""
identifier ::= "\"" lower id-tail "\""
account-ref ::= "\"account://" authority "/" identifier-body "\""
product-ref ::= "\"product://" authority "/" identifier-body "/v" positive-digits "\""
pack-ref ::= "\"pack://" authority "/" path "/v" positive-digits "\""
jurisdiction-ref ::= "\"jurisdiction://" authority "/" path "/v" positive-digits "\""
intent-ref ::= "\"intent://" authority "/" path "\""
grant-ref ::= "\"grant://" authority "/" path "\""
sha256 ::= "\"" hex64 "\""
authority ::= lower authority-tail
authority-tail ::= ([a-z0-9.-])*
path ::= path-char (path-char)*
path-char ::= [A-Za-z0-9._:/-]
identifier-body ::= lower id-tail
id-tail ::= ([a-z0-9._:-])*
positive-digits ::= [1-9] ([0-9])*
hex64 ::= hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex
hex ::= [a-f0-9]
lower ::= [a-z]
