# Revision: 1ea2a90bd5b90a768ad2b36a9c1c330523bc80b4
# Compatibility projection; domain conformance remains authoritative.

LIFECYCLE legal-obligation VERSION 1
DESCRIPTION "Location-bound legal obligation and grant compatibility projection"
STATE UNBOUND INITIAL
STATES [BOUND, ACCEPTED, RESTRICTED, EXPIRED]
STATES [WITHDRAWN, DENIED] TERMINAL
EVENTS [BIND_JURISDICTION, ACCEPT_POLICY, GRANT_LICENSE, RESTRICT, WITHDRAW, EXPIRE, DENY]
EVIDENCES [JURISDICTION_EVIDENCE, POLICY_ACCEPTANCE, LICENSE_GRANT, POLICY_DECISION, WITHDRAWAL_DECISION, EXPIRATION_EVIDENCE]
TRANSITION [UNBOUND, EXPIRED] -> BOUND ON BIND_JURISDICTION REQUIRES JURISDICTION_EVIDENCE
TRANSITION UNBOUND -> DENIED ON DENY REQUIRES POLICY_DECISION
TRANSITION BOUND -> ACCEPTED ON ACCEPT_POLICY REQUIRES POLICY_ACCEPTANCE
TRANSITION [BOUND, ACCEPTED] -> RESTRICTED ON RESTRICT REQUIRES POLICY_DECISION
TRANSITION [BOUND, ACCEPTED] -> EXPIRED ON EXPIRE REQUIRES EXPIRATION_EVIDENCE
TRANSITION ACCEPTED -> ACCEPTED ON GRANT_LICENSE REQUIRES LICENSE_GRANT
TRANSITION [ACCEPTED, RESTRICTED] -> WITHDRAWN ON WITHDRAW REQUIRES WITHDRAWAL_DECISION
END
